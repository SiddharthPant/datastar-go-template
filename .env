APP_ENV=dev
HOST=localhost
PORT=8080
LOG_LEVEL=info
APP_BASE_URL=http://${HOST}:${PORT}
SEED_PASSWORD=ChangeMe123!
MIN_PASSWORD_LENGTH=12

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SQLC_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/postgres
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=0
DATABASE_CONNECT_TIMEOUT="5s"
DATABASE_IDLE_TIMEOUT="30s"

# -----------------------------------------------------------------------------
# NATS
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_NAME=app
NATS_CONNECT_TIMEOUT="5s"

# -----------------------------------------------------------------------------
# Media storage
# -----------------------------------------------------------------------------
MEDIA_STORAGE_KIND=s3
MEDIA_STORAGE_DIR=.local/app-media

MEDIA_S3_BUCKET=app-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY_ID=rustfsadmin
MEDIA_S3_SECRET_ACCESS_KEY=rustfsadmin
MEDIA_S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------
SMTP_ADDR=localhost:1025
SMTP_FROM=noreply@example.test
